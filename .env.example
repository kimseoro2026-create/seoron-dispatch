# 디지털융합플랫폼 인증키 (사용신청 승인 후 발급, 헤더 api_user_key_id)
KOREACONNECT_API_USER_KEY_ID=
# OSRM 서버 주소 (osrm/README.md 참고). 비워두면 대략값으로 계산
OSRM_URL=http://localhost:5000
# 도보 경로 서버(osrm/prepare-foot.ps1). 비워두면 직선거리 대략값으로 걷는 시간을 계산
OSRM_FOOT_URL=http://localhost:5001
# 같은 값이면 같은 가상 구가 생성됨
F0_SEED=42
OSRM_TIME_FACTOR=1.0
